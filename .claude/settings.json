{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "NotebookEdit(*)",
      "Agent(*)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(*rm -rf*)",
      "Bash(*rm -r*)",
      "Bash(* --delete*)",
      "Bash(git branch -D*)",
      "Bash(git branch -d*)",
      "Bash(git push*--delete*)",
      "Bash(git push*:*)"
    ]
  }
}
